* text=auto eol=lf

# MSBuild and Visual Studio expect CRLF line endings.
*.cs   text eol=crlf
*.csproj text eol=crlf
*.sln  text eol=crlf
*.ps1  text eol=crlf

# The game and the mod read these files as bytes, so they must never be normalised.
*.png  binary
*.psd  binary
*.otf  binary
*.dll  binary
data/fonts/alagard-unicode-tmp binary
